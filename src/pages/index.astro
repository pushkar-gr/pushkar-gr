---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import ZoneAbout from '../components/ZoneAbout.astro';
import ZoneExperience from '../components/ZoneExperience.astro';
import ZoneSkills from '../components/ZoneSkills.astro';
import ZoneProjects from '../components/ZoneProjects.astro';
import ZoneContact from '../components/ZoneContact.astro';

const response = await fetch('https://raw.githubusercontent.com/pushkar-gr/pushkar-gr/refs/heads/main/portfolio-data.json');
const data = await response.json();
---

<Layout>
    <Sidebar />
    <main>
        <ZoneAbout user={data.user} />
        <ZoneExperience experience={data.experience} />
        <ZoneSkills skills={data.skills} />
        <ZoneProjects projects={data.projects} />
        <ZoneContact contact={data.user.contact} />
    </main>
</Layout>
